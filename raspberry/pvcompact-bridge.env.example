# Copy to /etc/pvcompact-bridge.env and protect with chmod 600.
# Credentials are identical to your existing PV Compact / EMQX connection.
WATT_LOCAL_HOST=192.168.178.26
# Leave empty if the WattWächter REST API has no READ-token protection.
WATT_READ_TOKEN=
MQTT_HOST=YOUR_EMQX_HOSTNAME
MQTT_PORT=8883
MQTT_TOPIC_PREFIX=YOUR_EXISTING_WATTWAECHTER_TOPIC_PREFIX
MQTT_USERNAME=YOUR_EMQX_USERNAME
MQTT_PASSWORD=YOUR_EMQX_PASSWORD
